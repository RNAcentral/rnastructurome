nextflow_process {

    name "Test Process RNAFRAMEWORK_RFCOUNT"
    script "../main.nf"
    process "RNAFRAMEWORK_RFCOUNT"

    tag "modules"
    tag "modules_local"
    tag "rnaframework"
    tag "rnaframework/count"
    config "./nextflow.config"

    test("rfcount - stub") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', principle:'RT-stop', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'ref' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.rc.size() == 1 },
                { assert process.out.rci.size() == 1 },
                { assert process.out.index_rci.size() == 1 },
                { assert process.out.error_log.size() == 1 },
                { assert process.out.samtools_log.size() == 1 },
                { assert process.out.summary.size() == 1 },
                { assert path(process.out.summary[0][1]).text.contains('covered') }
            )
        }
    }

    // The nf-core sarscov2 BAM carries no MD tags and keeps unmapped mates, both of which send
    // rf-count -m down its calmd path, where it never re-indexes the BAM and dies on the split.
    test("rfcount - map mode on a BAM without MD tags") {

        when {
            params {
                module_args = '-m --sort-by-read-name --properly-paired'
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', principle:'MaP', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'ref' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.rc.size() == 1 },
                { assert path(process.out.log[0][1]).text.contains('[+] All done.') }
            )
        }
    }

    // An ambiguity code in the reference reaches the MD tag via calmd, and rf-count's MD parser
    // loops forever on it. The config's time limit turns that hang into a failure.
    test("rfcount - map mode on a reference with IUPAC ambiguity codes") {

        when {
            params {
                module_args = '-m --sort-by-read-name --properly-paired'
            }
            process {
                """
                def ref = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                def iupac = file("\${workDir}/iupac.fasta")
                iupac.text = ref.text.readLines().collect { it.startsWith('>') ? it : it.replaceFirst('T', 'Y') }.join('\\n') + '\\n'
                input[0] = Channel.of([
                    [ id:'test', principle:'MaP', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ])
                input[1] = Channel.of([ [ id:'ref' ], iupac ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.rc.size() == 1 },
                { assert path(process.out.log[0][1]).text.contains('[+] All done.') }
            )
        }
    }

    // Exercises the --rfcount_max_coverage path. This BAM is ~0.9x, under any valid cap, so the
    // measurement runs and decides not to subsample; rf-count must still complete unchanged.
    test("rfcount - coverage cap leaves a shallow BAM untouched") {

        when {
            params {
                module_args = '-m --sort-by-read-name --properly-paired'
                rfcount_max_coverage = 1
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', principle:'MaP', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'ref' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.rc.size() == 1 },
                { assert path(process.out.log[0][1]).text.contains('[+] All done.') }
            )
        }
    }
}
