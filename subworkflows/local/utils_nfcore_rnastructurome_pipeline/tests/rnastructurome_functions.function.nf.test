nextflow_function {

    name "rnastructurome pure helper functions"
    script "../main.nf"

    test("resolveReferenceKey normalises a binomial organism") {
        function "resolveReferenceKey"
        when { function { """ input[0] = [ id: 's1', organism: 'Homo sapiens' ] """ } }
        then { assert function.success; assert function.result == 'homo_sapiens' }
    }

    test("resolveReferenceKey falls back to --organism") {
        function "resolveReferenceKey"
        when {
            params { organism = 'mus_musculus' }
            function { """ input[0] = [ id: 's2' ] """ }
        }
        then { assert function.success; assert function.result == 'mus_musculus' }
    }

    test("resolveRfNormNormMethod default depends on scoring method") {
        function "resolveRfNormNormMethod"
        when { function { """ input[0] = 2 """ } }
        then { assert function.success; assert function.result == 2 }
    }

    test("resolveRfNormNormMethod default for non-2 scoring method is 3") {
        function "resolveRfNormNormMethod"
        when { function { """ input[0] = 1 """ } }
        then { assert function.success; assert function.result == 3 }
    }

    test("resolveRfNormScoreMethod defaults by principle and untreated control") {
        function "resolveRfNormScoreMethod"
        when { function { """ input[0] = 'rt-stop'; input[1] = true """ } }
        then { assert function.success; assert function.result == 1 }
    }

    test("resolveRfNormScoreMethod allows explicit scoring override") {
        function "resolveRfNormScoreMethod"
        when {
            params { rfnorm_score_method = 2 }
            function { """ input[0] = 'rt-stop'; input[1] = true """ }
        }
        then { assert function.success; assert function.result == 2 }
    }

    test("resolveRfNormScoreMethod rejects unsupported scoring override") {
        function "resolveRfNormScoreMethod"
        when {
            params { rfnorm_score_method = 99 }
            function { """ input[0] = 'rt-stop'; input[1] = true """ }
        }
        then { assert function.failed }
    }

    test("rfNormScoringLabel maps known codes") {
        function "rfNormScoringLabel"
        when { function { """ input[0] = 1 """ } }
        then { assert function.success; assert function.result == 'Ding' }
    }

    test("rfNormNormLabel maps known codes") {
        function "rfNormNormLabel"
        when { function { """ input[0] = 3 """ } }
        then { assert function.success; assert function.result == 'Box-plot normalisation' }
    }

    test("resolveReferenceResolution fasta: local --fasta wins (genome route)") {
        function "resolveReferenceResolution"
        when {
            params { transcriptome = false; fasta = '/x.fa' }
            function { """ input[0] = [ id: 's', organism: 'homo_sapiens' ]; input[1] = 'fasta' """ }
        }
        then { assert function.success; assert function.result == [ 'homo_sapiens', 'path::/x.fa', 'homo_sapiens' ] }
    }

    test("resolveReferenceResolution fasta: defaults to ensembl by key") {
        function "resolveReferenceResolution"
        when {
            params { fasta = null; gtf = null }
            function { """ input[0] = [ id: 's', organism: 'homo_sapiens' ]; input[1] = 'fasta' """ }
        }
        then { assert function.success; assert function.result == [ 'homo_sapiens', 'ensembl::homo_sapiens', 'homo_sapiens' ] }
    }

    test("resolveReferenceResolution fasta: ensembl_species_map maps alias") {
        function "resolveReferenceResolution"
        when {
            params { fasta = null; gtf = null; ensembl_species_map = [ human: 'homo_sapiens' ] }
            function { """ input[0] = [ id: 's', organism: 'human' ]; input[1] = 'fasta' """ }
        }
        then { assert function.success; assert function.result == [ 'human', 'ensembl::homo_sapiens', 'human' ] }
    }

    test("resolveReferenceResolution fasta: ncbi accessions list joins") {
        function "resolveReferenceResolution"
        when {
            params { fasta = null; gtf = null; ncbi_accessions_map = [ ec: [ 'X1', 'X2' ] ] }
            function { """ input[0] = [ id: 's', organism: 'ec' ]; input[1] = 'fasta' """ }
        }
        then { assert function.success; assert function.result == [ 'ec', 'ncbi::X1,X2', 'ec' ] }
    }

    test("resolveReferenceResolution gtf: --gtf path wins") {
        function "resolveReferenceResolution"
        when {
            params { gtf = '/a.gtf' }
            function { """ input[0] = [ id: 's', organism: 'homo_sapiens' ]; input[1] = 'gtf' """ }
        }
        then { assert function.success; assert function.result == [ 'homo_sapiens', 'path::/a.gtf', 'homo_sapiens' ] }
    }

    test("resolveReferenceResolution gtf: ncbi accessions yield none:: (synthetic GTF)") {
        function "resolveReferenceResolution"
        when {
            params { fasta = null; gtf = null; ncbi_accessions_map = [ ec: 'X1' ] }
            function { """ input[0] = [ id: 's', organism: 'ec' ]; input[1] = 'gtf' """ }
        }
        then { assert function.success; assert function.result == [ 'ec', 'none::', 'ec' ] }
    }

    test("renderBowtie1Args renders deterministic default args") {
        function "renderBowtie1Args"
        when {
            params {
                bowtie_all = true
                bowtie_k = 1
                bowtie_trim5 = 0
                bowtie_trim3 = 0
                bowtie_v = null
                bowtie_n = 2
                bowtie_max = 1
                bowtie_chunkmbs = 512
            }
        }
        then {
            assert function.success
            assert function.result == '-a -l 28 -n 2 --best --strata --chunkmbs 512'
        }
    }

    test("parseFlagstatMappedPct reads the percentage off the mapped line") {
        function "parseFlagstatMappedPct"
        when {
            function {
                """
                def flagstat = File.createTempFile('flagstat', '.txt')
                flagstat.text = '''1000 + 0 in total (QC-passed reads + QC-failed reads)
0 + 0 secondary
850 + 0 mapped (85.00% : N/A)
'''
                input[0] = flagstat
                """
            }
        }
        then { assert function.success; assert function.result == 85.00 }
    }

    test("isSmallReference is true for a viral-sized FASTA") {
        function "isSmallReference"
        when {
            function {
                """
                def small = File.createTempFile('viral', '.fa'); small.text = '>NC_001477.1\\n' + ('ACGT' * 2500) + '\\n'
                def large = File.createTempFile('bacterial', '.fa'); large.text = '>chr\\n' + ('ACGT' * 300000) + '\\n'
                input[0] = [ id: 's1', organism: 'Dengue virus (EDEN3295)' ]
                input[1] = [ dengue_virus_eden3295: [ [:], small ], escherichia_coli: [ [:], large ] ]
                """
            }
        }
        then { assert function.success; assert function.result == true }
    }

    test("isSmallReference is false for a reference FASTA over 1 MB") {
        function "isSmallReference"
        when {
            function {
                """
                def large = File.createTempFile('bacterial', '.fa'); large.text = '>chr\\n' + ('ACGT' * 300000) + '\\n'
                input[0] = [ id: 's1', organism: 'Escherichia coli' ]
                input[1] = [ escherichia_coli: [ [:], large ] ]
                """
            }
        }
        then { assert function.success; assert function.result == false }
    }

    test("parseCoverageMinMeanDepth returns the least-covered contig of a segmented genome") {
        function "parseCoverageMinMeanDepth"
        when {
            function {
                """
                def coverage = File.createTempFile('coverage', '.txt')
                coverage.text = [
                    ['#rname', 'startpos', 'endpos', 'numreads', 'covbases', 'coverage', 'meandepth', 'meanbaseq', 'meanmapq'],
                    ['NC_002023.1', '1', '2341', '900000', '2341', '100', '28839.5', '35.1', '42'],
                    ['NC_002020.1', '1', '890', '1200', '880', '98.9', '101.1', '34.8', '42'],
                    ['NC_002016.1', '1', '1027', '400', '700', '68.2', '29.2', '35.0', '42'],
                ].collect { row -> row.join('\\t') }.join('\\n') + '\\n'
                input[0] = coverage
                """
            }
        }
        then { assert function.success; assert function.result == [ 'NC_002016.1', 29.2 ] }
    }

    test("parseCoverageMinMeanDepth fails on a header-only file") {
        function "parseCoverageMinMeanDepth"
        when {
            function {
                """
                def coverage = File.createTempFile('coverage', '.txt')
                coverage.text = ['#rname', 'startpos', 'endpos', 'numreads', 'covbases', 'coverage', 'meandepth', 'meanbaseq', 'meanmapq'].join('\\t') + '\\n'
                input[0] = coverage
                """
            }
        }
        then { assert function.failed }
    }

    test("parseRfcountSummaryRow parses a MaP-mode row") {
        function "parseRfcountSummaryRow"
        when {
            function {
                """
                def tsv = File.createTempFile('map_summary', '.tsv')
                tsv.text = "sample\\tcovered\\tmutated_alignments\\tpct_mutated\\tpct_a_muts\\tpct_c_muts\\tpct_g_muts\\tpct_u_muts\\n" +
                           "s1\\t1000\\t123/1000\\t12.3\\t40.0\\t30.0\\t20.0\\t10.0\\n"
                input[0] = tsv
                """
            }
        }
        then {
            assert function.success
            assert function.result == [ pct_a: 40.0, pct_c: 30.0, pct_g: 20.0, pct_u: 10.0, pct_mutated: 12.3 ]
        }
    }

    test("parseRfcountSummaryRow parses an RT-stop-mode row (real DMS example)") {
        function "parseRfcountSummaryRow"
        when {
            function {
                """
                def tsv = File.createTempFile('rtstop_summary', '.tsv')
                tsv.text = "sample\\tcovered\\tpct_a_muts\\tpct_c_muts\\tpct_g_muts\\tpct_u_muts\\n" +
                           "WT_Rep1_100mM_DMS_r1\\t4223\\t47.23\\t12.81\\t18.34\\t21.62\\n"
                input[0] = tsv
                """
            }
        }
        then {
            assert function.success
            assert function.result == [ pct_a: 47.23, pct_c: 12.81, pct_g: 18.34, pct_u: 21.62, pct_mutated: null ]
        }
    }

    test("parseRfcountSummaryRow treats MaP 'NA' pct_mutated as null (zero counted alignments)") {
        function "parseRfcountSummaryRow"
        when {
            function {
                """
                def tsv = File.createTempFile('map_zero_summary', '.tsv')
                tsv.text = "sample\\tcovered\\tmutated_alignments\\tpct_mutated\\tpct_a_muts\\tpct_c_muts\\tpct_g_muts\\tpct_u_muts\\n" +
                           "s1\\t0\\t-\\tNA\\t25.0\\t25.0\\t25.0\\t25.0\\n"
                input[0] = tsv
                """
            }
        }
        then { assert function.success; assert function.result.pct_mutated == null }
    }

    test("parseFastqcSummary returns allowlisted FAILs, ignoring WARN/absent modules") {
        function "parseFastqcSummary"
        when {
            function {
                """
                def zipFile = File.createTempFile('sample_fastqc', '.zip')
                new java.util.zip.ZipOutputStream(zipFile.newOutputStream()).with { zos ->
                    zos.putNextEntry(new java.util.zip.ZipEntry('sample_fastqc/summary.txt'))
                    zos.write((
                        "PASS\\tBasic Statistics\\tsample.fastq.gz\\n" +
                        "FAIL\\tPer base sequence quality\\tsample.fastq.gz\\n" +
                        "WARN\\tPer sequence quality scores\\tsample.fastq.gz\\n" +
                        "FAIL\\tSequence Duplication Levels\\tsample.fastq.gz\\n"
                    ).bytes)
                    zos.closeEntry()
                    zos.close()
                }
                input[0] = zipFile
                input[1] = ['Basic Statistics', 'Per base sequence quality', 'Per tile sequence quality', 'Per sequence quality scores']
                """
            }
        }
        then {
            // FAIL + allowlisted -> kept; WARN -> ignored; FAIL but not allowlisted (duplication) -> ignored;
            // "Per tile sequence quality" is allowlisted but absent from summary.txt -> ignored, not a failure.
            assert function.success
            assert function.result == [ 'Per base sequence quality' ]
        }
    }

    test("parseFastqcSummary returns an empty list when nothing allowlisted fails") {
        function "parseFastqcSummary"
        when {
            function {
                """
                def zipFile = File.createTempFile('clean_fastqc', '.zip')
                new java.util.zip.ZipOutputStream(zipFile.newOutputStream()).with { zos ->
                    zos.putNextEntry(new java.util.zip.ZipEntry('clean_fastqc/summary.txt'))
                    zos.write("PASS\\tBasic Statistics\\tclean.fastq.gz\\nFAIL\\tOverrepresented sequences\\tclean.fastq.gz\\n".bytes)
                    zos.closeEntry()
                    zos.close()
                }
                input[0] = zipFile
                input[1] = ['Basic Statistics']
                """
            }
        }
        then { assert function.success; assert function.result == [] }
    }

    test("rnacentralQcGate is a no-op when --rnacentral is off") {
        function "rnacentralQcGate"
        when {
            params { rnacentral = false; outdir = "$outputDir" }
            function { """ input[0] = 'Test check'; input[1] = false; input[2] = 'should not abort' """ }
        }
        then {
            assert function.success
            assert !new File("${outputDir}/pipeline_info/rnacentral_qc_report.txt").exists()
        }
    }

    test("rnacentralQcGate aborts and writes the report when a check fails") {
        function "rnacentralQcGate"
        when {
            params { rnacentral = true; outdir = "$outputDir" }
            function { """ input[0] = 'Test check'; input[1] = false; input[2] = 'sample X at 10%' """ }
        }
        then {
            assert function.failed
            def report = new File("${outputDir}/pipeline_info/rnacentral_qc_report.txt")
            assert report.exists()
            assert report.text.contains('Test check')
            assert report.text.contains('sample X at 10%')
        }
    }

    test("rnacentralQcGate does not error or write a report when the check passes") {
        function "rnacentralQcGate"
        when {
            params { rnacentral = true; outdir = "$outputDir" }
            function { """ input[0] = 'Test check'; input[1] = true; input[2] = 'irrelevant' """ }
        }
        then {
            assert function.success
            assert !new File("${outputDir}/pipeline_info/rnacentral_qc_report.txt").exists()
        }
    }

    test("sharedGroupPrefixLength counts leading tokens in common") {
        function "sharedGroupPrefixLength"
        when { function { """ input[0] = 'HFF_infected_HCMV_05hpi'; input[1] = 'HFF_infected_HCMV_72hpi' """ } }
        then { assert function.success; assert function.result == 3 }
    }

    test("sharedGroupPrefixLength separates the arms of an infection timecourse") {
        function "sharedGroupPrefixLength"
        when { function { """ input[0] = 'HFF_infected_HCMV_05hpi'; input[1] = 'HFF_uninfected' """ } }
        then { assert function.success; assert function.result == 1 }
    }

    test("sharedGroupPrefixLength keeps the cell-line fallback working") {
        function "sharedGroupPrefixLength"
        when { function { """ input[0] = 'MDA-MB-231_MTX'; input[1] = 'MDA-MB-231_DMSO' """ } }
        then { assert function.success; assert function.result == 1 }
    }

    test("sharedGroupPrefixLength returns the whole list when one group is a prefix of the other") {
        function "sharedGroupPrefixLength"
        when { function { """ input[0] = 'HEK293T'; input[1] = 'HEK293T_MTX' """ } }
        then { assert function.success; assert function.result == 1 }
    }

    test("sharedGroupPrefixLength is zero for unrelated groups") {
        function "sharedGroupPrefixLength"
        when { function { """ input[0] = 'K562_invitro'; input[1] = 'HEK293T' """ } }
        then { assert function.success; assert function.result == 0 }
    }

    test("sharedGroupPrefixLength does not match on a partial token") {
        function "sharedGroupPrefixLength"
        when { function { """ input[0] = 'HFF_infected'; input[1] = 'HFFX_infected' """ } }
        then { assert function.success; assert function.result == 0 }
    }
    test("selectClosestControl prefers the candidate sharing the most of the group name") {
        function "selectClosestControl"
        when { function { """ input[0] = 'untreated'; input[1] = 'HFF_HCMV_05hpi_1'; input[2] = [ [ prefix: 1, same_replicate: true, control_group: 'HFF_uninfected_1', rc: 'HFF_uninfected_1.rc' ], [ prefix: 2, same_replicate: true, control_group: 'HFF_HCMV_72hpi_1', rc: 'HFF_HCMV_72hpi_1.rc' ] ] """ } }
        then { assert function.success; assert function.result == [ 'HFF_HCMV_05hpi_1', 'HFF_HCMV_72hpi_1.rc' ] }
    }

    test("selectClosestControl prefers the same replicate among equally close candidates") {
        function "selectClosestControl"
        when { function { """ input[0] = 'untreated'; input[1] = 'A_x_2'; input[2] = [ [ prefix: 1, same_replicate: false, control_group: 'A_y_1', rc: 'A_y_1.rc' ], [ prefix: 1, same_replicate: true, control_group: 'A_z_2', rc: 'A_z_2.rc' ] ] """ } }
        then { assert function.success; assert function.result == [ 'A_x_2', 'A_z_2.rc' ] }
    }

    test("selectClosestControl reuses a lone control across replicates") {
        function "selectClosestControl"
        when { function { """ input[0] = 'untreated'; input[1] = 'HFF_uninfected_2'; input[2] = [ [ prefix: 2, same_replicate: false, control_group: 'HFF_uninfected_1', rc: 'HFF_uninfected_1.rc' ], [ prefix: 1, same_replicate: false, control_group: 'HFF_HCMV_72hpi_1', rc: 'HFF_HCMV_72hpi_1.rc' ] ] """ } }
        then { assert function.success; assert function.result == [ 'HFF_uninfected_2', 'HFF_uninfected_1.rc' ] }
    }

    test("selectClosestControl errors on a tie at the same replicate for untreated") {
        function "selectClosestControl"
        when { function { """ input[0] = 'untreated'; input[1] = 'A_z_1'; input[2] = [ [ prefix: 1, same_replicate: true, control_group: 'A_x_1', rc: 'A_x_1.rc' ], [ prefix: 1, same_replicate: true, control_group: 'A_y_1', rc: 'A_y_1.rc' ] ] """ } }
        then { assert function.failed }
    }

    test("selectClosestControl errors on a tie at the same replicate for denatured too") {
        function "selectClosestControl"
        when { function { """ input[0] = 'denatured'; input[1] = 'A_z_1'; input[2] = [ [ prefix: 1, same_replicate: true, control_group: 'A_x_1', rc: 'A_x_1.rc' ], [ prefix: 1, same_replicate: true, control_group: 'A_y_1', rc: 'A_y_1.rc' ] ] """ } }
        then { assert function.failed }
    }

    test("selectClosestControl returns nothing when two arms are equally distant") {
        function "selectClosestControl"
        when { function { """ input[0] = 'untreated'; input[1] = 'A_z_3'; input[2] = [ [ prefix: 1, same_replicate: false, control_group: 'A_x_1', rc: 'A_x_1.rc' ], [ prefix: 1, same_replicate: false, control_group: 'A_y_2', rc: 'A_y_2.rc' ] ] """ } }
        then { assert function.success; assert function.result == [ 'A_z_3', null ] }
    }

    test("selectClosestControl treats several runs of one control group as a single control") {
        function "selectClosestControl"
        when { function { """ input[0] = 'untreated'; input[1] = 'RVA_RF_20uM_NSP2_in_vitro_1'; input[2] = [ [ prefix: 2, same_replicate: true, control_group: 'RVA_RF_no_NSP2_in_vitro_1', rc: 'pool_S5_S6.rc' ], [ prefix: 2, same_replicate: true, control_group: 'RVA_RF_no_NSP2_in_vitro_1', rc: 'pool_S10_S11.rc' ], [ prefix: 2, same_replicate: true, control_group: 'RVA_RF_no_NSP2_in_vitro_1', rc: 'pool_total.rc' ] ] """ } }
        then { assert function.success; assert function.result[0] == 'RVA_RF_20uM_NSP2_in_vitro_1'; assert function.result[1] != null }
    }
}
